# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Neon pooled URL). Used by the app, migrations and seed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# OpenAI-compatible chat completions provider (xAI Grok by default).
# Backup: AI_BASE_URL="https://openrouter.ai/api/v1" with an OpenRouter key and model.
AI_API_KEY=""
AI_BASE_URL="https://api.x.ai/v1"
AI_MODEL=""
