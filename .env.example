# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Neon pooled URL). Used by the app, migrations and seed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Any OpenAI-compatible chat completions provider (Google Gemini by default).
# Backups: Groq https://api.groq.com/openai/v1 · xAI https://api.x.ai/v1 · OpenRouter https://openrouter.ai/api/v1
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-3.1-flash-lite"

# Optional backup provider, used automatically when the primary is overloaded (429/5xx).
AI_FALLBACK_API_KEY=""
AI_FALLBACK_BASE_URL="https://api.groq.com/openai/v1"
AI_FALLBACK_MODEL="openai/gpt-oss-120b"
