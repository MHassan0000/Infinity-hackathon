    "bcryptjs": "https://registry.npmjs.org/bcryptjs/-/bcryptjs-3.0.3.tgz",
    "class-variance-authority": "https://registry.npmjs.org/class-variance-authority/-/class-variance-authority-0.7.1.tgz",
    "clsx": "https://registry.npmjs.org/clsx/-/clsx-2.1.1.tgz",
    "drizzle-orm": "https://registry.npmjs.org/drizzle-orm/-/drizzle-orm-0.45.3.tgz",
    "jose": "https://registry.npmjs.org/jose/-/jose-6.2.12.tgz",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "https://registry.npmjs.org/server-only/-/server-only-0.0.1.tgz",
    "tailwind-merge": "https://registry.npmjs.org/tailwind-merge/-/tailwind-merge-3.7.0.tgz",
    "zod": "https://registry.npmjs.org/zod/-/zod-4.6.5.tgz"
